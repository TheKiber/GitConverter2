#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает запрос по справочнику по указанному отборы и параметрам.
Функция ЗапросПоЭлементам(Отбор, ПоляУпорядочивания = "", КоличествоПервых = 0) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	Таблица.Ссылка КАК Ссылка,
	|	Таблица.ПометкаУдаления КАК ПометкаУдаления,
	|	Таблица.Наименование КАК Наименование,
	|	Таблица.Адрес КАК Адрес,
	|	Таблица.АдресРепозиторияGit КАК АдресРепозиторияGit,
	|	Таблица.ВерсияВGit КАК ВерсияВGit,
	|	Таблица.ВерсияПлатформыХранилища КАК ВерсияПлатформыХранилища,
	|	Таблица.ВыгружатьИзменения КАК ВыгружатьИзменения,
	|	Таблица.ВыполнятьКоммиты КАК ВыполнятьКоммиты,
	|	Таблица.ЗапретитьИспользованиеОбщихОчередей КАК ЗапретитьИспользованиеОбщихОчередей,
	|	Таблица.ИмяВетки КАК ИмяВетки,
	|	Таблица.ИмяПользователяХранилища КАК ИмяПользователяХранилища,
	|	Таблица.КаталогВыгрузкиВерсий КАК КаталогВыгрузкиВерсий,
	|	Таблица.ИмяПроектаEDT КАК ИмяПроектаEDT,
	|	Таблица.КаталогДляАрхивацииОшибок КАК КаталогДляАрхивацииОшибок,
	|	Таблица.КоличествоКоммитов КАК КоличествоКоммитов,
	|	Таблица.ЛокальныйКаталогGit КАК ЛокальныйКаталогGit,
	|	Таблица.МаксимальноеКоличествоПодготавливаемыхВерсий КАК МаксимальноеКоличествоПодготавливаемыхВерсий,
	|	Таблица.МинимальноеКоличествоМетаданных КАК МинимальноеКоличествоМетаданных,
	|	Таблица.ОбрабатыватьВсеОчереди КАК ОбрабатыватьВсеОчереди,
	|	Таблица.Описание КАК Описание,
	|	Таблица.ОтправлятьКоммитыВРепозиторийGit КАК ОтправлятьКоммитыВРепозиторийGit,
	|	Таблица.ПарольПользователяХранилища КАК ПарольПользователяХранилища,
	|	Таблица.ПарольСервераGit КАК ПарольСервераGit,
	|	Таблица.ПерваяВерсия КАК ПерваяВерсия,
	|	Таблица.ПользовательСервераGit КАК ПользовательСервераGit,
	|	Таблица.ПоследняяВерсия КАК ПоследняяВерсия,
	|	Таблица.РазрешитьПомещатьАнонимноЕслиНеНайденПользователь КАК РазрешитьПомещатьАнонимноЕслиНеНайденПользователь,
	|	Таблица.ИдентификаторЗадания КАК ИдентификаторЗадания,
	|	Таблица.УдалятьВременныеДанныеВерсииПослеКоммита КАК УдалятьВременныеДанныеВерсииПослеКоммита,
	|	Таблица.УдалятьКонфигурацииПоставщиков КАК УдалятьКонфигурацииПоставщиков,
	|	Таблица.ВерсияВGit.Код КАК КодВерсииВGit,
	|	Таблица.ВозниклаОшибка КАК ВозниклаОшибка,
	|	Таблица.КоличествоОшибок КАК КоличествоОшибок
	|ИЗ
	|	Справочник.ХранилищаКонфигураций КАК Таблица";
	
	Если КоличествоПервых > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВЫБРАТЬ ПЕРВЫЕ 1000", "ВЫБРАТЬ ПЕРВЫЕ " + Формат(КоличествоПервых, "ЧГ="));
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВЫБРАТЬ ПЕРВЫЕ 1000", "ВЫБРАТЬ");
	КонецЕсли;
	
	// Отборы.
	ФрагментыУсловий = Новый Массив;
	Для Каждого КлючИЗначение Из Отбор Цикл
		ИмяРеквизита = КлючИЗначение.Ключ;
		ЗначениеОтбора = КлючИЗначение.Значение;
		// Фиксированный массив преобразуем в обычный.
		Если ТипЗнч(ЗначениеОтбора) = Тип("ФиксированныйМассив") Тогда
			ЗначениеОтбора = Новый Массив(ЗначениеОтбора);
		КонецЕсли;
		Запрос.УстановитьПараметр(ИмяРеквизита, ЗначениеОтбора);
		Если ТипЗнч(ЗначениеОтбора) = Тип("Массив") Тогда
			ФрагментыУсловий.Добавить(СтрШаблон("Таблица.%1 В (&%1)", ИмяРеквизита))
		Иначе
			ФрагментыУсловий.Добавить(СтрШаблон("Таблица.%1 = &%1", ИмяРеквизита))
		КонецЕсли;
	КонецЦикла;
	Если ФрагментыУсловий.Количество() > 0 Тогда
		Запрос.Текст = Запрос.Текст + "
		|ГДЕ
		|	" + СтрСоединить(ФрагментыУсловий, Символы.ПС + Символы.Таб + Символы.Таб + "И ");
	КонецЕсли;
	
	// Порядок.
	Если ЗначениеЗаполнено(ПоляУпорядочивания) Тогда
		Запрос.Текст = Запрос.Текст + "
		|
		|УПОРЯДОЧИТЬ ПО
		|	" + ПоляУпорядочивания;
	КонецЕсли;
	
	Возврат Запрос;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДополнитьПараметрыХранилища(ПараметрыХранилища) Экспорт
	ПараметрыХранилища.КаталогВыгрузкиВерсий = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ПараметрыХранилища.КаталогВыгрузкиВерсий);
	
	Если ТипЗнч(ПараметрыХранилища.КодВерсииВGit) <> Тип("Число") Тогда
		ПараметрыХранилища.КодВерсииВGit = 0;
	КонецЕсли;
	
	////////////////////////////////////////////////////////////////////////////////
	// Каталоги локального репозитория Git.
	
	// Путь к папке репозитория Git: "</path_to_git>/".
	ЛокальныйКаталогGit = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ПараметрыХранилища.ЛокальныйКаталогGit);
	
	// Путь к папке проекта в репозитории Git: "<ProjectName>/".
	ОтносительноеИмяКаталогаПроектаEDT = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ПараметрыХранилища.ИмяПроектаEDT);
	
	// Путь к проекту в репозитории: "</path_to_git>/<ProjectName>/.
	ПараметрыХранилища.Вставить("РепозиторийGit_ПутьКПроектуEDT", ЛокальныйКаталогGit + ОтносительноеИмяКаталогаПроектаEDT);
	
	// Путь к папке src в репозитории Git: "<ProjectName>/src/".
	ОтносительноеИмяКаталогаИсходниковEDT = ОтносительноеИмяКаталогаПроектаEDT + "src";
	ОтносительноеИмяКаталогаИсходниковEDT = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ОтносительноеИмяКаталогаИсходниковEDT);
	
	// Путь к файлам конфигурации проекта в репозитории: "</path_to_git>/<ProjectName>/src/.
	ПараметрыХранилища.Вставить("РепозиторийGit_ПутьКИсходникамEDT", ЛокальныйКаталогGit + ОтносительноеИмяКаталогаИсходниковEDT);
	
	////////////////////////////////////////////////////////////////////////////////
	// Константы.
	
	ПараметрыХранилища.Вставить("МаксимальноеКоличествоИнкрементальныхВерсийПодряд", Константы.МаксимальноеКоличествоИнкрементальныхВерсийПодряд.Получить());
	Если ПараметрыХранилища.МаксимальноеКоличествоИнкрементальныхВерсийПодряд < 1 Тогда
		ПараметрыХранилища.МаксимальноеКоличествоИнкрементальныхВерсийПодряд = 10;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#КонецЕсли
