  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	Шапка.Ссылка КАК Ссылка,
	Шапка.ПометкаУдаления КАК ПометкаУдаления,
	Шапка.Владелец КАК Владелец,
	Шапка.Код КАК Код,
	Шапка.ДатаСоздания КАК ДатаСоздания,
	Шапка.Пользователь КАК Пользователь,
	Шапка.Автор КАК Автор,
	Шапка.Комментарий КАК Комментарий,
	Шапка.Состояние КАК Состояние,
	Шапка.КаталогВременныхФайлов КАК КаталогВременныхФайлов,
	Шапка.Источник КАК Источник,
	Шапка.КоличествоМетаданных КАК КоличествоМетаданных,
	Шапка.ВыгруженыТолькоИзменения КАК ВыгруженыТолькоИзменения,
	Шапка.Предопределенный КАК Предопределенный,
	Шапка.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	ЕСТЬNULL(ИнформацияОКоммиттере.Email, ЕСТЬNULL(ОбщаяИнформацияОКоммиттере.Email, ЕСТЬNULL(ОбщиеНастрокиПользователей.Email, &quot;&quot;))) КАК Email,
	ЕСТЬNULL(ИнформацияОбАвторе.Email, ЕСТЬNULL(ОбщаяИнформацияОбАвторе.Email, &quot;&quot;)) КАК АвторEmail,
	Шапка.ВерсияДанных КАК ВерсияДанных,
	Шапка.ВерсияКонфигурации КАК ВерсияКонфигурации,
	Шапка.ВозниклаОшибка КАК ВозниклаОшибка,
	Шапка.ДатаНачалаОбработки КАК ДатаНачалаОбработки,
	Шапка.КоличествоОшибок КАК КоличествоОшибок,
	Шапка.ТекстОшибки КАК ТекстОшибки,
	Шапка.ТребуетсяПолнаяВыгрузка КАК ТребуетсяПолнаяВыгрузка,
	Шапка.Хеш КАК Хеш
ИЗ
	Справочник.ВерсииХранилища КАК Шапка
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИнформацияПользователей КАК ИнформацияОКоммиттере
		ПО Шапка.Пользователь = ИнформацияОКоммиттере.Пользователь
			И Шапка.Владелец = ИнформацияОКоммиттере.Хранилище
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИнформацияПользователей КАК ОбщаяИнформацияОКоммиттере
		ПО Шапка.Пользователь = ОбщаяИнформацияОКоммиттере.Пользователь
			И (ОбщаяИнформацияОКоммиттере.Хранилище = ЗНАЧЕНИЕ(Справочник.ХранилищаКонфигураций.ПустаяСсылка))
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИнформацияПользователей КАК ОбщиеНастрокиПользователей
		ПО (ОбщиеНастрокиПользователей.Пользователь = &quot;&quot;)}
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИнформацияПользователей КАК ИнформацияОбАвторе
		ПО Шапка.Автор = ИнформацияОбАвторе.Пользователь
			И Шапка.Владелец = ИнформацияОбАвторе.Хранилище
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИнформацияПользователей КАК ОбщаяИнформацияОбАвторе
		ПО Шапка.Автор = ОбщаяИнформацияОбАвторе.Пользователь
			И (ОбщаяИнформацияОбАвторе.Хранилище = ЗНАЧЕНИЕ(Справочник.ХранилищаКонфигураций.ПустаяСсылка))}</queryText>
      <mainTable>Catalog.ВерсииХранилища</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Состав</dataPath>
        <field>Состав</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
