#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Элементы.ИзмененияРегламентныхЗаданийИдентификаторЗадания.Видимость = Истина;
	Элементы.ИзмененияРегламентныхЗаданийПрименитьИзменения.Видимость = Ложь;
	// Значения "по умолчанию"
	КоличествоОчередейXML = 2;
	КоличествоОчередейEDT = 2;
	ЧастотаЗапусков = 15;
	ВремяНачала = '00010101010000';
	ВремяЗавершения = '00010101235959';
	Понедельник = Истина;
	Вторник = Истина;
	Среда = Истина;
	Четверг = Истина;
	Пятница = Истина;
	Суббота = Истина;
	Воскресенье = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЧастотаЗапусковРегулирование(Элемент, Направление, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ЧастотаЗапусков = Цел(ЧастотаЗапусков / 5 + Направление) * 5;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИзмененияРегламентныхЗаданий

&НаКлиенте
Процедура ИзмененияРегламентныхЗаданийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ДанныеСтроки = Элементы.ИзмененияРегламентныхЗаданий.ДанныеСтроки(ВыбраннаяСтрока);
	Если ДанныеСтроки <> Неопределено И ЗначениеЗаполнено(ДанныеСтроки.Ссылка) Тогда
		ПараметрыФормы = Новый Структура("Ключ", ДанныеСтроки.Ссылка);
		ОткрытьФорму("Справочник.ОчередиВыполнения.ФормаОбъекта", ПараметрыФормы);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьИзменения(Команда)
	ЗаполнитьИзмененияНаСервере(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьИзменения(Команда)
	ЗаполнитьИзмененияНаСервере(Истина);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьИзмененияНаСервере(Записывать)
	Если Записывать Тогда
		Элементы.ИзмененияРегламентныхЗаданийПрименитьИзменения.Видимость = Ложь;
		Элементы.ИзмененияРегламентныхЗаданийНаименованиеБыло.Гиперссылка = Ложь;
		Элементы.ИзмененияРегламентныхЗаданийНаименованиеБыло.ГиперссылкаЯчейки = Ложь;
		Элементы.ИзмененияРегламентныхЗаданийНаименованиеСтанет.Гиперссылка = Истина;
		Элементы.ИзмененияРегламентныхЗаданийНаименованиеСтанет.ГиперссылкаЯчейки = Истина;
	Иначе
		Элементы.ИзмененияРегламентныхЗаданийЗаполнитьИзменения.КнопкаПоУмолчанию = Ложь;
		Элементы.ИзмененияРегламентныхЗаданийПрименитьИзменения.Видимость = Истина;
		Элементы.ИзмененияРегламентныхЗаданийНаименованиеБыло.Гиперссылка = Истина;
		Элементы.ИзмененияРегламентныхЗаданийНаименованиеБыло.ГиперссылкаЯчейки = Истина;
		Элементы.ИзмененияРегламентныхЗаданийНаименованиеСтанет.Гиперссылка = Ложь;
		Элементы.ИзмененияРегламентныхЗаданийНаименованиеСтанет.ГиперссылкаЯчейки = Ложь;
	КонецЕсли;
	
	ИзмененияРегламентныхЗаданий.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОчередиВыполнения.Ссылка КАК Ссылка,
	|	ОчередиВыполнения.ПометкаУдаления КАК ПометкаУдаления,
	|	ОчередиВыполнения.Операция КАК Операция,
	|	ОчередиВыполнения.Наименование КАК Наименование,
	|	ОчередиВыполнения.ИдентификаторЗадания КАК ИдентификаторЗадания,
	|	ОчередиВыполнения.ИспользованиеЗадания КАК ИспользованиеЗадания,
	|	ОчередиВыполнения.ПредставлениеРасписания КАК ПредставлениеРасписания
	|ИЗ
	|	Справочник.ОчередиВыполнения КАК ОчередиВыполнения
	|ГДЕ
	|	ОчередиВыполнения.Хранилище = ЗНАЧЕНИЕ(Справочник.ХранилищаКонфигураций.ПустаяСсылка)";
	Таблица = Запрос.Выполнить().Выгрузить();
	ЗаполнитьПоПараметрам(Записывать, Таблица, Перечисления.ОперацииОчереди.ВыгрузкаВXML);
	ЗаполнитьПоПараметрам(Записывать, Таблица, Перечисления.ОперацииОчереди.ЗагрузкаВEDT);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоПараметрам(Записывать, Таблица, Операция)
	Если Операция = Перечисления.ОперацииОчереди.ВыгрузкаВXML Тогда
		КоличествоОчередей = КоличествоОчередейXML;
	Иначе
		КоличествоОчередей = КоличествоОчередейEDT;
	КонецЕсли;
	
	ОчередиВБазе = Таблица.Скопировать(Новый Структура("Операция", Операция));
	ОчередиВБазе.Сортировать("Наименование");
	
	Если Записывать Тогда
		НадписьБыло = НСтр("ru = 'Было:'");
		НадписьСтанет = НСтр("ru = 'Стало:'");
	Иначе
		НадписьБыло = НСтр("ru = 'Было:'");
		НадписьСтанет = НСтр("ru = 'Станет:'");
	КонецЕсли;
	
	Расписание = РасписаниеПоУмолчанию();
	Расписание.ПериодПовтораВТечениеДня = ЧастотаЗапусков * КоличествоОчередей;
	
	ВсегоЭлементовСправочника = ОчередиВБазе.Количество();
	ОсталосьЭлементовСправочника = ВсегоЭлементовСправочника;
	
	ДлинаНомера = Log10(КоличествоОчередей) + 1;
	ФорматНомера = СтрШаблон("ЧЦ=%1; ЧВН=; ЧГ=", ДлинаНомера);
	Для НомерОчереди = 1 По Макс(КоличествоОчередей, ВсегоЭлементовСправочника) Цикл
		СтрокаРезультат = ИзмененияРегламентныхЗаданий.Добавить();
		СтрокаРезультат.НадписьБыло = НадписьБыло;
		СтрокаРезультат.НадписьСтанет = НадписьСтанет;
		
		Расписание.ВремяНачала = ВремяНачала + (НомерОчереди-1)*ЧастотаЗапусков;
		
		ПометкаУдаленияСтанет = (НомерОчереди > КоличествоОчередей);
		СтрокаРезультат.ИспользованиеЗаданияСтанет = Не ПометкаУдаленияСтанет;
		СтрокаРезультат.ПредставлениеРасписанияСтанет = ?(ПометкаУдаленияСтанет, "", Строка(Расписание));
		СтрокаРезультат.НаименованиеСтанет = СтрШаблон(НСтр("ru = 'Общая - %1 - %2'"), Строка(Операция), Формат(НомерОчереди, ФорматНомера));
		
		ЕстьДанныеСправочника = (ОсталосьЭлементовСправочника > 0);
		Если ЕстьДанныеСправочника Тогда
			ОсталосьЭлементовСправочника = ОсталосьЭлементовСправочника - 1;
			ДанныеСправочника = ОчередиВБазе[НомерОчереди - 1];
			СтрокаРезультат.Ссылка = ДанныеСправочника.Ссылка;
			СтрокаРезультат.НаименованиеБыло = ДанныеСправочника.Наименование;
			СтрокаРезультат.ИспользованиеЗаданияБыло = ДанныеСправочника.ИспользованиеЗадания;
			СтрокаРезультат.ПредставлениеРасписанияБыло = ДанныеСправочника.ПредставлениеРасписания;
			МассивЧтоИзменится = Новый Массив;
			Если СтрокаРезультат.НаименованиеБыло <> СтрокаРезультат.НаименованиеСтанет Тогда
				МассивЧтоИзменится.Добавить(НСтр("ru = 'изменено наименование'"));
			КонецЕсли;
			Если СтрокаРезультат.ИспользованиеЗаданияБыло И Не СтрокаРезультат.ИспользованиеЗаданияСтанет Тогда
				МассивЧтоИзменится.Добавить(НСтр("ru = 'отключено задание'"));
			ИначеЕсли Не СтрокаРезультат.ИспользованиеЗаданияБыло И СтрокаРезультат.ИспользованиеЗаданияСтанет Тогда
				МассивЧтоИзменится.Добавить(НСтр("ru = 'включено задание'"));
			КонецЕсли;
			Если СтрокаРезультат.ПредставлениеРасписанияБыло <> СтрокаРезультат.ПредставлениеРасписанияСтанет Тогда
				МассивЧтоИзменится.Добавить(НСтр("ru = 'изменено расписание'"));
			КонецЕсли;
			Если ДанныеСправочника.ПометкаУдаления И Не ПометкаУдаленияСтанет Тогда
				МассивЧтоИзменится.Добавить(НСтр("ru = 'снята пометка на удаление'"));
			ИначеЕсли Не ДанныеСправочника.ПометкаУдаления И ПометкаУдаленияСтанет Тогда
				МассивЧтоИзменится.Добавить(НСтр("ru = 'установлена пометка на удаление'"));
			КонецЕсли;
			Если МассивЧтоИзменится.Количество() > 0 Тогда
				ЧтоИзменится = СтрСоединить(МассивЧтоИзменится, ", ");
				Если Записывать Тогда
					СтрокаРезультат.ЧтоИзменится = ВРег(Лев(ЧтоИзменится, 1)) + Сред(ЧтоИзменится, 2);
					СправочникОбъект = ДанныеСправочника.Ссылка.ПолучитьОбъект();
					Если СправочникОбъект.ПометкаУдаления <> ПометкаУдаленияСтанет Тогда
						СправочникОбъект.УстановитьПометкуУдаления(ПометкаУдаленияСтанет);
					КонецЕсли;
					СправочникОбъект.Наименование = СтрокаРезультат.НаименованиеСтанет;
					СправочникОбъект.ДополнительныеСвойства.Вставить("Расписание", Расписание);
					СправочникОбъект.ДополнительныеСвойства.Вставить("Использование", СтрокаРезультат.ИспользованиеЗаданияСтанет);
					СправочникОбъект.Записать();
				Иначе
					СтрокаРезультат.ЧтоИзменится = СтрШаблон(НСтр("ru = 'Будет %1'"), ЧтоИзменится);
				КонецЕсли;
			Иначе
				Если Записывать Тогда
					СтрокаРезультат.ЧтоИзменится = НСтр("ru = 'Ничего не изменилось'");
				Иначе
					СтрокаРезультат.ЧтоИзменится = НСтр("ru = 'Ничего не изменится (все ОК)'");
				КонецЕсли;
			КонецЕсли;
		Иначе
			Если Записывать Тогда
				СтрокаРезультат.ЧтоИзменится = НСтр("ru = 'Добавлен новый элемент справочника Очереди'");
				СправочникОбъект = Справочники.ОчередиВыполнения.СоздатьЭлемент();
				СправочникОбъект.Операция = Операция;
				СправочникОбъект.Наименование = СтрокаРезультат.НаименованиеСтанет;
				СправочникОбъект.ДополнительныеСвойства.Вставить("Расписание", Расписание);
				СправочникОбъект.ДополнительныеСвойства.Вставить("Использование", СтрокаРезультат.ИспользованиеЗаданияСтанет);
				СправочникОбъект.Записать();
				СтрокаРезультат.Ссылка = СправочникОбъект.Ссылка;
			Иначе
				СтрокаРезультат.ЧтоИзменится = НСтр("ru = 'Будет добавлен новый элемент справочника Очереди'");
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция РасписаниеПоУмолчанию()
	Расписание = Новый РасписаниеРегламентногоЗадания;
	
	// Каждый день.
	Расписание.ПериодПовтораДней = 1;
	
	// Период запуска - с 22:00 до 22:30.
	Расписание.ВремяНачала = ВремяНачала;
	Расписание.ВремяКонца = ВремяЗавершения;
	
	Если Понедельник И Вторник И Среда И Четверг И Пятница И Суббота И Воскресенье Тогда
		// В любой день недели.
	Иначе
		ДниНедели = Новый Массив;
		Если Понедельник Тогда
			ДниНедели.Добавить(1);
		КонецЕсли;
		Если Вторник Тогда
			ДниНедели.Добавить(2);
		КонецЕсли;
		Если Среда Тогда
			ДниНедели.Добавить(3);
		КонецЕсли;
		Если Четверг Тогда
			ДниНедели.Добавить(4);
		КонецЕсли;
		Если Пятница Тогда
			ДниНедели.Добавить(5);
		КонецЕсли;
		Если Суббота Тогда
			ДниНедели.Добавить(6);
		КонецЕсли;
		Если Воскресенье Тогда
			ДниНедели.Добавить(7);
		КонецЕсли;
		Расписание.ДниНедели = ДниНедели;
	КонецЕсли;
	
	Возврат Расписание;
КонецФункции

#КонецОбласти
