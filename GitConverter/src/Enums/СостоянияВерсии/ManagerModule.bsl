#Область СлужебныйПрограммныйИнтерфейс

// Возвращает префикс для имен файлов в зависимости от состояния версии.
//
// Параметры:
//   Состояние - ПеречислениеСсылка.СостоянияВерсии
//
// Возвращаемое значение:
//   Строка - Префикс.
//
Функция ПрефиксИмениФайла(Состояние) Экспорт
	Если Состояние = ПолучаетсяCF
		Или Состояние = ПолученCF Тогда
		Возврат "ПолучениеCF";
	ИначеЕсли Состояние = ВыгружаетсяВXML
		Или Состояние = ВыгруженаВXML Тогда
		Возврат "ВыгрузкаВXML";
	ИначеЕсли Состояние = ЗагружаетсяВEDT
		Или Состояние = ЗагруженаВEDT Тогда
		Возврат "ЗагрузкаВEDT";
	ИначеЕсли Состояние = ПомещаетсяВGit
		Или Состояние = ПомещенаВGit Тогда
		Возврат "КоммитВGIT";
	Иначе
		Возврат Строка(Состояние);
	КонецЕсли;
КонецФункции

Функция СостоянияВКоторыхЕстьXML() Экспорт
	Результат = Новый Массив;
	Результат.Добавить(ВыгруженаВXML);
	Результат.Добавить(ЗагружаетсяВEDT);
	Результат.Добавить(ЗагруженаВEDT);
	Результат.Добавить(ПомещаетсяВGit);
	Результат.Добавить(ПомещенаВGit);
	Возврат Результат;
КонецФункции

Функция СостоянияПриНачалеОпераций() Экспорт
	Результат = Новый Массив;
	Результат.Добавить(ПолучаетсяCF);
	Результат.Добавить(ВыгружаетсяВXML);
	Результат.Добавить(ЗагружаетсяВEDT);
	Результат.Добавить(ПомещаетсяВGit);
	Возврат Результат;
КонецФункции

Функция ПорядокСостояний() Экспорт
	Результат = Новый Соответствие;
	Результат.Вставить(ПустаяСсылка(), 0);
	Результат.Вставить(ПолучаетсяCF, 1);
	Результат.Вставить(ПолученCF, 2);
	Результат.Вставить(ВыгружаетсяВXML, 3);
	Результат.Вставить(ВыгруженаВXML, 4);
	Результат.Вставить(ЗагружаетсяВEDT, 5);
	Результат.Вставить(ЗагруженаВEDT, 6);
	Результат.Вставить(ПомещаетсяВGit, 7);
	Результат.Вставить(ПомещенаВGit, 8);
	Возврат Результат;
КонецФункции

#КонецОбласти
