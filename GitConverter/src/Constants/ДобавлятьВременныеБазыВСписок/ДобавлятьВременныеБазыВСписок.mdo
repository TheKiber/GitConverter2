    <valueManagerType typeId="7767770c-0685-4ee0-a1ab-2b9902695350" valueTypeId="aa167757-546f-4185-afe0-c18c9e91e4ba"/>
    <valueKeyType typeId="0622621e-3525-5681-ac40-be11738bbf7a" valueTypeId="39e56736-e8f9-5b4c-9a02-07652f4ee8dc"/>
