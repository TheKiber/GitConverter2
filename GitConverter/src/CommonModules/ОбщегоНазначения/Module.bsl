#Область СлужебныйПрограммныйИнтерфейс

Функция ВыполнитьВФоне(Ключ, ИмяМетода, Представление, Параметр1, Параметр2 = Null, Параметр3 = Null) Экспорт
	Отбор = Новый Структура();
	Отбор.Вставить("Ключ", Ключ);
	Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	Отбор.Вставить("ИмяМетода", ИмяМетода);
	
	МассивФоновыхЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	Если МассивФоновыхЗаданий.Количество() > 0 Тогда
		Возврат МассивФоновыхЗаданий[0];
	КонецЕсли;
	
	Параметры = ОбщегоНазначения.МассивЗначений(Параметр1, Параметр2, Параметр3);
	Возврат ФоновыеЗадания.Выполнить(ИмяМетода, Параметры, Ключ, Лев(Представление, 120));
КонецФункции

#Область ОбработкаСобытийПриложения

// Выполняет стандартные действия перед началом работы пользователя.
Процедура ПередНачаломРаботыСистемы(ПараметрыПриложения = Неопределено) Экспорт
	
	Если ПараметрыПриложения <> Неопределено Тогда
		ПараметрыКлиентаНаСервере = Новый Соответствие(ПараметрыСеанса.ПараметрыКлиентаНаСервере);
		Для Каждого КлючИЗначение Из ПараметрыПриложения Цикл
			ПараметрыКлиентаНаСервере.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		ПараметрыСеанса.ПараметрыКлиентаНаСервере = Новый ФиксированноеСоответствие(ПараметрыКлиентаНаСервере);
	КонецЕсли;
	
	Если НеобходимоОбновлениеИБ() Тогда
		ОбновитьИБ();
		Константы.ВерсияДанныхИБ.Установить(Метаданные.Версия);
		ПараметрыПриложения.Вставить("ВыполненоОбновлениеИБ", Истина);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеИБ

// Возвращает Истина если необходимо обновление данных информационной базы при смене версии конфигурации.
Функция НеобходимоОбновлениеИБ() Экспорт
	
	Возврат Метаданные.Версия <> Константы.ВерсияДанныхИБ.Получить()
		Или СтрНайти(
			НРег(ПараметрыСеанса.ПараметрыКлиентаНаСервере.Получить("ПараметрЗапуска")),
			НРег("ЗапуститьОбновлениеИнформационнойБазы")) > 0;
	
КонецФункции

Процедура ОбновитьИБ(ВерсияС = Неопределено, ВерсияПо = Неопределено) Экспорт
	КонвертацияОстановленаДо = Константы.КонвертацияОстановлена.Получить();
	Константы.КонвертацияОстановлена.Установить(Истина);
	
	Если ВерсияС = Неопределено Тогда
		ВерсияС = Константы.ВерсияДанныхИБ.Получить();
	КонецЕсли;
	Если ВерсияПо = Неопределено Тогда
		ВерсияПо = Метаданные.Версия;
	КонецЕсли;
	Если ВерсияЧислом(ВерсияС) <= ВерсияЧислом("2.0.1.1") И ВерсияЧислом("2.0.1.1") <= ВерсияЧислом(ВерсияПо) Тогда
		Справочники.ХранилищаКонфигураций.ЗаполнитьПредставленияРасписаний();
		Справочники.ОчередиВыполнения.ЗаполнитьПредставленияРасписаний();
		Справочники.КопииХранилищКонфигурации.ЗаполнитьПредставленияРасписаний();
		Константы.МаксимальноеКоличествоЧастичныхВыгрузокПодряд.Установить(10);
	КонецЕсли;
	
	Константы.КонвертацияОстановлена.Установить(КонвертацияОстановленаДо);
КонецПроцедуры

// Преобразует строковое представление версии в числовое.
Функция ВерсияЧислом(СтрокаВерсии, КоличествоРазрядов = 4, МножительРазрядов = 10000) Экспорт
	Если Не ЗначениеЗаполнено(СтрокаВерсии) Тогда
		Возврат 0;
	КонецЕсли;
	Результат = 0;
	Фрагменты = СтрРазделить(СтрокаВерсии, ".");
	Разряд = 0;
	Для Каждого ФрагментВерсии Из Фрагменты Цикл
		Результат = Результат * МножительРазрядов + Число(ФрагментВерсии);
		Разряд = Разряд + 1;
	КонецЦикла;
	Если Разряд <> КоличествоРазрядов Тогда
		Результат = Результат / Pow(МножительРазрядов, Разряд - КоличествоРазрядов);
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Работа_с_DOM_и_XPath

// На основании XML получает структуру с документом DOM и разыменователем пространств имен DOM.
//   Полученную структуру можно передавать в другие методы модуля в качестве параметра СтруктураDOM.
//
// Параметры:
//   ПолноеИмяФайлаXML - Строка - Полное имя файла в формате XML.
//
// Возвращаемое значение:
//   Структура - Информация о документе DOM.
//       * ДокументDOM - ДокументDOM
//       * Разыменователь - РазыменовательПространствИменDOM
//       * ПолноеИмяФайлаXML - Строка
//       * ДокументИзменен - Булево - Ложь
//
Функция СтруктураDOM(ПолноеИмяФайлаXML) Экспорт
	Если Не ЭтоФайлXML(ПолноеИмяФайлаXML) Тогда
		Возврат Неопределено;
	КонецЕсли;
	СтруктураDOM = Новый Структура;
	СтруктураDOM.Вставить("ДокументDOM", ДокументDOM(ПолноеИмяФайлаXML));
	СтруктураDOM.Вставить("Разыменователь", Новый РазыменовательПространствИменDOM(СтруктураDOM.ДокументDOM));
	СтруктураDOM.Вставить("ПолноеИмяФайлаXML", ПолноеИмяФайлаXML);
	Возврат СтруктураDOM;
КонецФункции

// Возвращает Истина если указанный файл является файлом XML.
Функция ЭтоФайлXML(ПолноеИмяФайлаXML) Экспорт
	Если Не ФайлСуществует(ПолноеИмяФайлаXML) Тогда
		Возврат Ложь;
	КонецЕсли;
	ЧтениеXML = Новый ЧтениеXML;
	Попытка
		ЧтениеXML.ОткрытьФайл(ПолноеИмяФайлаXML);
		ЧтениеXML.ПерейтиКСодержимому();
		ЧтениеXML.Закрыть();
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// На основании XML получает документ DOM.
//
// Параметры:
//   ПолноеИмяФайлаXML - Строка - Полное имя файла в формате XML.
//
// Возвращаемое значение:
//   ДокументDOM
//
Функция ДокументDOM(ПолноеИмяФайлаXML) Экспорт
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ПолноеИмяФайлаXML);
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	ЧтениеXML.Закрыть();
	
	Возврат ДокументDOM;
КонецФункции

// Записывает документ DOM в файл.
//
// Параметры:
//   ДокументDOM - ДокументDOM - См. функцию ДокументDOM.
//   ИмяФайла - Строка
//
Процедура ЗаписатьДокументDOM(ДокументDOM, ИмяФайла) Экспорт
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайла);
	ЗаписьDOM = Новый ЗаписьDOM;
	ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
КонецПроцедуры

// Находит узел документа DOM используя выражение XPath.
//
// Параметры:
//   СтруктураDOM - Структура - См. СтруктураDOM.
//   ВыражениеXPath - Строка - См. в синтакс-помощнике "ДокументDOM.ВычислитьВыражениеXPath", параметр "Выражение".
//   ЭлементDOM - Произвольный - Элемент документа, в контексте которого выполняется поиск.
//       См. в синтакс-помощнике "ДокументDOM.ВычислитьВыражениеXPath", параметр "УзелКонтекста".
//
// Возвращаемое значение:
//   Неопределено - Если элемент не найден.
//   ЭлементDOM, Произвольный - См. в синтакс-помощнике "РезультатXPath.ПолучитьСледующий", возвращаемое значение.
//
Функция НайтиУзелDOM(Знач СтруктураDOM, Знач ВыражениеXPath, Знач ЭлементDOM = Неопределено) Экспорт
	Возврат ВычислитьВыражениеXPath(СтруктураDOM, ВыражениеXPath, ЭлементDOM).ПолучитьСледующий();
КонецФункции

// Находит узел документа DOM используя выражение XPath.
//
// Параметры:
//   СтруктураDOM - Структура - См. СтруктураDOM.
//   ЛокальноеИмя - Строка - Имя элемента или маска имени. Допускается использование предопределенного шаблона '*'.
//
// Возвращаемое значение:
//   Неопределено - Если элемент не найден.
//   ЭлементDOM, Произвольный - См. в синтакс-помощнике "СписокЭлементовDOM", элементы коллекции.
//
Функция НайтиУзелDOMПоИмени(Знач СтруктураDOM, Знач ЛокальноеИмя) Экспорт
	СписокЭлементовDOM = СтруктураDOM.ДокументDOM.ПолучитьЭлементыПоИмени("*", ЛокальноеИмя);
	Возврат ?(СписокЭлементовDOM.Количество() > 0, СписокЭлементовDOM[0], Неопределено);
КонецФункции

// Вычисляет выражение XPath для документа DOM.
//
// Параметры:
//   СтруктураDOM - Структура - См. СтруктураDOM.
//   ВыражениеXPath - Строка - См. в синтакс-помощнике "ДокументDOM.ВычислитьВыражениеXPath", параметр "Выражение".
//   ЭлементDOM - Произвольный - Элемент документа, в контексте которого выполняется поиск.
//       См. в синтакс-помощнике "ДокументDOM.ВычислитьВыражениеXPath", параметр "УзелКонтекста".
//
// Возвращаемое значение:
//   РезультатXPath - См. в синтакс-помощнике "ДокументDOM.ВычислитьВыражениеXPath".
//
Функция ВычислитьВыражениеXPath(Знач СтруктураDOM, Знач ВыражениеXPath, Знач ЭлементDOM = Неопределено) Экспорт
	Если ЭлементDOM = Неопределено Тогда
		ЭлементDOM = СтруктураDOM.ДокументDOM;
	КонецЕсли;
	Возврат СтруктураDOM.ДокументDOM.ВычислитьВыражениеXPath(ВыражениеXPath, ЭлементDOM, СтруктураDOM.Разыменователь);
КонецФункции

// Возвращает массив имен языков конфигурации.
//
// Параметры:
//   СтруктураDOM - Структура - Объект корня конфигурации полученный методом СтруктураDOM.
//
// Возвращаемое значение:
//   Массив из Строка - Массив имен языков конфигурации.
//
Функция ИменаЯзыковКонфигурацииXML(Знач СтруктураDOM) Экспорт
	МассивИмен = Новый Массив;
	Выражение = "/xmlns:MetaDataObject/xmlns:Configuration/xmlns:ChildObjects/xmlns:Language";
	РезультатXPath = ВычислитьВыражениеXPath(СтруктураDOM, Выражение);
	Пока Истина Цикл
		Язык_ЭлементDOM = РезультатXPath.ПолучитьСледующий();
		Если Язык_ЭлементDOM = Неопределено Тогда
			Прервать;
		КонецЕсли;
		МассивИмен.Добавить(Язык_ЭлементDOM.ТекстовоеСодержимое);
	КонецЦикла;
	Возврат МассивИмен;
КонецФункции

// Возвращает версию конфигурации.
//
// Параметры:
//   СтруктураDOM - Структура - Объект корня конфигурации полученный методом СтруктураDOM.
//
// Возвращаемое значение:
//   Массив из Строка - Массив имен языков конфигурации.
//
Функция ВерсияКонфигурацииXML(СтруктураDOM) Экспорт
	// Формат 1С XML - файл Configuration.xml.
	Выражение = "//*[local-name()='Configuration']/*[local-name()='Properties']/*[local-name()='Version']";
	УзелВерсии = НайтиУзелDOM(СтруктураDOM, Выражение);
	Если УзелВерсии = Неопределено Тогда
		// Формат EDT - файл Configuration\Configuration.mdo.
		Выражение = "/*[local-name()='Configuration']/*[local-name()='version']";
		УзелВерсии = НайтиУзелDOM(СтруктураDOM, Выражение);
	КонецЕсли;
	Если УзелВерсии = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат СокрЛП(УзелВерсии.ТекстовоеСодержимое);
КонецФункции

#КонецОбласти

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

#Область IniФайлы

Функция ТаблицаИзIniФайла(ПолноеИмяФайла, Кодировка = Неопределено, ИменаДополнительныхКолонок = Неопределено) Экспорт
	Перем Ключ, Значение, ИмяКолонки;
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Секция", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("СекцияНРег", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Содержимое", Новый ОписаниеТипов("Строка"));
	
	ЕстьДополнительныеКолонки = (ИменаДополнительныхКолонок <> Неопределено);
	Если ЕстьДополнительныеКолонки Тогда
		Для Каждого КлючИЗначение Из ИменаДополнительныхКолонок Цикл
			Результат.Колонки.Добавить(КлючИЗначение.Значение, Новый ОписаниеТипов("Строка"));
		КонецЦикла;
	КонецЕсли;
	
	Если Не ФайлСуществует(ПолноеИмяФайла) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ПолноеИмяФайла);
	Если Кодировка = Неопределено Тогда
		Кодировка = КодировкаBOM(ДвоичныеДанные);
		Если Кодировка = Неопределено Тогда
			Кодировка = "UTF-8";
		КонецЕсли;
	КонецЕсли;
	ЧтениеТекста = СтроковыеФункции.ЧтениеТекстаИзДвоичныхДанных(ДвоичныеДанные, Кодировка);
	ТекущаяСекция = Неопределено;
	НомерСтроки = 0;
	Порядок = 0;
	Пока Истина Цикл
		СтрокаТекста = ЧтениеТекста.ПрочитатьСтроку();
		Если СтрокаТекста = Неопределено Тогда
			Прервать;
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
		СтрокаТекста = СокрЛП(СтрокаТекста);
		
		Если Лев(СтрокаТекста, 1) = "[" И Прав(СтрокаТекста, 1) = "]" Тогда
			Порядок = Порядок + 1;
			ТекущаяСекция = Результат.Добавить();
			ТекущаяСекция.Секция = СокрЛП(Сред(СтрокаТекста, 2, СтрДлина(СтрокаТекста) - 2));
			ТекущаяСекция.СекцияНРег = НРег(ТекущаяСекция.Секция);
			ТекущаяСекция.Порядок = Порядок;
			ТекущаяСекция.НомерСтроки = НомерСтроки;
			ТекущаяСекция.Содержимое = СтрокаТекста;
			Продолжить;
		ИначеЕсли ТекущаяСекция = Неопределено Тогда
			// Нулевая секция при необходимости.
			Если СтрокаТекста = "" Тогда
				Продолжить;
			КонецЕсли;
			ТекущаяСекция = Результат.Добавить(); // Секция = "", Порядок = 0, НомерСтроки = 1.
			ТекущаяСекция.Содержимое = СтрокаТекста;
			ТекущаяСекция.НомерСтроки = НомерСтроки;
			Продолжить;
		КонецЕсли;
		
		ТекущаяСекция.Содержимое = ТекущаяСекция.Содержимое + Символы.ПС + СтрокаТекста;
		
		Если ЕстьДополнительныеКолонки
			И СтрокаТекста <> ""
			И Лев(СтрокаТекста, 1) <> ";"
			И Лев(СтрокаТекста, 1) <> "#" Тогда
			Позиция = Найти(СтрокаТекста, "=");
			Если Позиция > 0 Тогда
				ИмяПараметра = Лев(СтрокаТекста, Позиция - 1);
				Если ИменаДополнительныхКолонок.Свойство(ИмяПараметра, ИмяКолонки) Тогда
					ТекущаяСекция[ИмяКолонки] = Сред(СтрокаТекста, Позиция + 1);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Процедура ТаблицаВIniФайл(Таблица, ПолноеИмяФайла, Кодировка, ЗаписатьBOM = Истина) Экспорт
	Файл = Новый Файл(ПолноеИмяФайла);
	Если Не КаталогСуществует(Файл.Путь) Тогда
		СоздатьКаталог(Файл.Путь);
	КонецЕсли;
	ЗаписьТекста = Новый ЗаписьТекста(ПолноеИмяФайла, Кодировка, , , ЗаписатьBOM);
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ЗаписьТекста.ЗаписатьСтроку(СтрокаТаблицы.Содержимое);
	КонецЦикла;
	ЗаписьТекста.Закрыть();
КонецПроцедуры

#КонецОбласти

#Область Кодировки

Функция КодировкаДвоичныхДанных(ДвоичныеДанные) Экспорт
	// Если есть BOM, то это первичная информация о том, в каком формате записан текст.
	КодировкаBOM = КодировкаBOM(ДвоичныеДанные);
	Если ЗначениеЗаполнено(КодировкаBOM) Тогда
		Возврат КодировкаBOM;
	КонецЕсли;
	Возврат КодировкаXML(ДвоичныеДанные);
КонецФункции

Функция КодировкаXML(XMLСтрокаИлиДвоичныеДанные) Экспорт
	// Список кодировок XML см. в https://msdn.microsoft.com/en-us/library/dd317756.aspx
	Если ТипЗнч(XMLСтрокаИлиДвоичныеДанные) = Тип("ДвоичныеДанные") Тогда
		БуферДвоичныхДанных = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(XMLСтрокаИлиДвоичныеДанные);
		ПотокВПамяти = Новый ПотокВПамяти(БуферДвоичныхДанных);
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.ОткрытьПоток(ПотокВПамяти);
	ИначеЕсли ТипЗнч(XMLСтрокаИлиДвоичныеДанные) = Тип("Строка") Тогда
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(XMLСтрокаИлиДвоичныеДанные);
	КонецЕсли;
	
	Попытка
		ЧтениеXML.ПерейтиКСодержимому();
		КодировкаXML = ЧтениеXML.КодировкаXML;
	Исключение
		КодировкаXML = "";
	КонецПопытки;
	
	ЧтениеXML.Закрыть();
	
	Если ТипЗнч(XMLСтрокаИлиДвоичныеДанные) = Тип("ДвоичныеДанные") Тогда
		ПотокВПамяти.Закрыть();
	КонецЕсли;
	
	Возврат КодировкаXML;
КонецФункции

Функция КодировкаBOM(ДвоичныеДанные)
	ЧтениеДанных = Новый ЧтениеДанных(ДвоичныеДанные);
	БуферДвоичныхДанных = ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных(5);
	ПрочитанныеБайты = Новый Массив(5);
	
	ВГраница = БуферДвоичныхДанных.Размер - 1;
	Для Индекс = 0 По 4 Цикл
		Если Индекс < БуферДвоичныхДанных.Размер Тогда
			ПрочитанныеБайты[Индекс] = БуферДвоичныхДанных[Индекс];
		Иначе // Неинициализированные байты считаем равными 0xA5, чтобы в случае меньшего размера файла не ошибиться в кодировке.
			ПрочитанныеБайты[Индекс] = ЧислоИзШестнадцатеричнойСтроки("0xA5");
		КонецЕсли;
	КонецЦикла;
	
	Если ПрочитанныеБайты[0] = ЧислоИзШестнадцатеричнойСтроки("0xFE")
		И ПрочитанныеБайты[1] = ЧислоИзШестнадцатеричнойСтроки("0xFF") Тогда
		КодировкаBOM = "UTF-16BE";
	ИначеЕсли ПрочитанныеБайты[0] = ЧислоИзШестнадцатеричнойСтроки("0xFF")
		И ПрочитанныеБайты[1] = ЧислоИзШестнадцатеричнойСтроки("0xFE") Тогда
		Если ПрочитанныеБайты[2] = ЧислоИзШестнадцатеричнойСтроки("0x00")
			И ПрочитанныеБайты[3] = ЧислоИзШестнадцатеричнойСтроки("0x00") Тогда
			КодировкаBOM = "UTF-32LE";
		Иначе
			КодировкаBOM = "UTF-16LE";
		КонецЕсли;
	ИначеЕсли ПрочитанныеБайты[0] = ЧислоИзШестнадцатеричнойСтроки("0xEF")
		И ПрочитанныеБайты[1] = ЧислоИзШестнадцатеричнойСтроки("0xBB")
		И ПрочитанныеБайты[2] = ЧислоИзШестнадцатеричнойСтроки("0xBF") Тогда
		КодировкаBOM = "UTF-8";
	ИначеЕсли ПрочитанныеБайты[0] = ЧислоИзШестнадцатеричнойСтроки("0x00")
		И ПрочитанныеБайты[1] = ЧислоИзШестнадцатеричнойСтроки("0x00")
		И ПрочитанныеБайты[2] = ЧислоИзШестнадцатеричнойСтроки("0xFE")
		И ПрочитанныеБайты[3] = ЧислоИзШестнадцатеричнойСтроки("0xFF") Тогда
		КодировкаBOM = "UTF-32BE";
	ИначеЕсли ПрочитанныеБайты[0] = ЧислоИзШестнадцатеричнойСтроки("0x0E")
		И ПрочитанныеБайты[1] = ЧислоИзШестнадцатеричнойСтроки("0xFE")
		И ПрочитанныеБайты[2] = ЧислоИзШестнадцатеричнойСтроки("0xFF") Тогда
		КодировкаBOM = "SCSU";
	ИначеЕсли ПрочитанныеБайты[0] = ЧислоИзШестнадцатеричнойСтроки("0xFB")
		И ПрочитанныеБайты[1] = ЧислоИзШестнадцатеричнойСтроки("0xEE")
		И ПрочитанныеБайты[2] = ЧислоИзШестнадцатеричнойСтроки("0x28") Тогда
		КодировкаBOM = "BOCU-1";
	ИначеЕсли ПрочитанныеБайты[0] = ЧислоИзШестнадцатеричнойСтроки("0x2B")
		И ПрочитанныеБайты[1] = ЧислоИзШестнадцатеричнойСтроки("0x2F")
		И ПрочитанныеБайты[2] = ЧислоИзШестнадцатеричнойСтроки("0x76")
		И (ПрочитанныеБайты[3] = ЧислоИзШестнадцатеричнойСтроки("0x38")
			Или ПрочитанныеБайты[3] = ЧислоИзШестнадцатеричнойСтроки("0x39")
			Или ПрочитанныеБайты[3] = ЧислоИзШестнадцатеричнойСтроки("0x2B")
			Или ПрочитанныеБайты[3] = ЧислоИзШестнадцатеричнойСтроки("0x2F")) Тогда
		КодировкаBOM = "UTF-7";
	ИначеЕсли ПрочитанныеБайты[0] = ЧислоИзШестнадцатеричнойСтроки("0xDD")
		И ПрочитанныеБайты[1] = ЧислоИзШестнадцатеричнойСтроки("0x73")
		И ПрочитанныеБайты[2] = ЧислоИзШестнадцатеричнойСтроки("0x66")
		И ПрочитанныеБайты[3] = ЧислоИзШестнадцатеричнойСтроки("0x73") Тогда
		КодировкаBOM = "UTF-EBCDIC";
	Иначе
		КодировкаBOM = "";
	КонецЕсли;
	
	Возврат КодировкаBOM;
КонецФункции

