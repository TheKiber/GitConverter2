// Превращает строковый или числовой уровень критичности события в уровень журнала регистрации.
//
// Параметры:
//   Уровень - Число, Строка, УровеньЖурналаРегистрации - Уровень критичности события.
//
// Возвращаемое значение:
//   УровеньЖурналаРегистрации
//
Функция УровеньЖурнала(Знач Уровень) Экспорт
	Если ТипЗнч(Уровень) = Тип("УровеньЖурналаРегистрации") Тогда
		Возврат Уровень;
	ИначеЕсли Уровень = 1 Тогда
		Возврат УровеньЖурналаРегистрации.Ошибка;
	ИначеЕсли Уровень = 2 Тогда
		Возврат УровеньЖурналаРегистрации.Предупреждение;
	ИначеЕсли Уровень = 3 Тогда
		Возврат УровеньЖурналаРегистрации.Информация;
	ИначеЕсли Уровень = 4 Тогда
		Возврат УровеньЖурналаРегистрации.Примечание;
	Иначе
		Возврат УровеньЖурналаРегистрации[Уровень];
	КонецЕсли;
КонецФункции

// Превращает текст или информацию об ошибке в строку для записи в журнал регистрации.
//
// Параметры:
//   Текст - Строка, ИнформацияОбОшибке - Текст или информация об ошибке для записи в журнал.
//
// Возвращаемое значение:
//   Строка
//
Функция ТекстЖурнала(Текст) Экспорт
	Если ТипЗнч(Текст) = Тип("ИнформацияОбОшибке") Тогда
		Возврат ПодробноеПредставлениеОшибки(Текст);
	ИначеЕсли Текст = "" Тогда
		Возврат "";
	КонецЕсли;
	Результат = НСтр(СокрЛП(Текст), Метаданные.ОсновнойЯзык.КодЯзыка);
	Если Результат = "" Тогда
		Результат = СокрЛП(Текст);
	КонецЕсли;
	Возврат Результат;
КонецФункции

